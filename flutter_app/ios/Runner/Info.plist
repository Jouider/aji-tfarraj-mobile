<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Aji Tfarraj</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>aji_tfarraj</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.600996591716-5av5qjhfakmdlea96q0scpvcj208ki3d</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>GIDClientID</key>
		<string>600996591716-5av5qjhfakmdlea96q0scpvcj208ki3d.apps.googleusercontent.com</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>Nous avons besoin d'accéder à votre caméra pour prendre une photo de profil, scanner les QR codes et photographier votre pièce d'identité pour les retraits Wafacash.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Nous avons besoin d'accéder à votre galerie pour changer votre photo de profil ou choisir une photo de votre pièce d'identité pour les retraits Wafacash.</string>
		<key>GADApplicationIdentifier</key>
		<!-- Identifiant de l'app dans AdMob (un « ~ », pas un « / »). Les unités
	     viennent du serveur (GET /api/app-config → ads). Voir docs/publicite.md. -->
		<string>ca-app-pub-2833493160230222~2281948283</string>
		<!-- L'autorisation de suivi (ATT) : demandée une fois, quelques secondes
	     après l'ouverture, quand la publicité est allumée côté serveur
	     (AdMobGateway). Va avec la déclaration « suivi » dans App Store
	     Connect → Confidentialité de l'app : l'un sans l'autre bloque la
	     mise en vente. Traduite dans fr.lproj et ar.lproj. -->
		<key>NSUserTrackingUsageDescription</key>
		<string>Cela nous permet de vous montrer des publicités plus pertinentes. Aji Tfarraj reste gratuite grâce à elles.</string>
		<key>SKAdNetworkItems</key>
		<!-- Réseaux autorisés à mesurer une installation venue d'une publicité.
	     Google d'abord ; la liste complète des réseaux de médiation est
	     publiée par AdMob et se colle ici le jour où la médiation est
	     activée. -->
		<array>
			<dict>
				<key>SKAdNetworkIdentifier</key>
				<string>cstr6suwn9.skadnetwork</string>
			</dict>
		</array>
		<key>NSFaceIDUsageDescription</key>
		<string>Utilisez Face ID pour déverrouiller l'application et protéger vos billets.</string>
		<!-- Allow Railway media domain: TLS 1.3 uses CHACHA20-POLY1305 which is not
	     in the legacy ATS cipher whitelist. NSExceptionRequiresForwardSecrecy=false
	     relaxes the cipher requirement while keeping the connection HTTPS-only. -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
			<key>NSExceptionDomains</key>
			<dict>
				<key>up.railway.app</key>
				<dict>
					<key>NSIncludesSubdomains</key>
					<true/>
					<key>NSExceptionRequiresForwardSecrecy</key>
					<false/>
					<key>NSExceptionMinimumTLSVersion</key>
					<string>TLSv1.2</string>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>FlutterDeepLinkingEnabled</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
	</dict>
</plist>
